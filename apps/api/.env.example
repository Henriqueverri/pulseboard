APP_NAME=PulseBoard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# "*" when the API is only reachable through a platform proxy (Render); empty locally
TRUSTED_PROXIES=

# Public demo accounts created by `php artisan pulseboard:demo` (password: 12+ characters)
DEMO_PASSWORD=
DEMO_OWNER_EMAIL=demo@example.com
DEMO_MEMBER_EMAIL=demo-member@example.com
# Optional full key (pb_<12>_<40>) of the PulseBoard POS: a managed, non-expiring key of the demo
DEMO_INTEGRATION_KEY=

# PulseBoard Insights (config/ai.php). AI_ENABLED is the kill switch; organizations also opt in.
# AI_PROVIDER=scripted answers deterministically without a key or network (refused in production).
AI_ENABLED=false
AI_PROVIDER=scripted
AI_MODEL=gpt-6-luna
# Secret: set it only in your local .env or the hosting dashboard, never in Git.
OPENAI_API_KEY=
AI_DAILY_ORG_LIMIT=50
AI_DAILY_USER_LIMIT=20
AI_REQUESTS_PER_MINUTE=10
AI_DEMO_REQUESTS_PER_MINUTE_PER_IP=3
AI_DEMO_DAILY_IP_LIMIT=5
# Global estimated spend per calendar month (UTC); 0 blocks every new generation.
AI_MONTHLY_BUDGET_USD=5
# Applied by pulseboard:ai-prune on every container start (runs: at least 32 days).
AI_INSIGHTS_RETENTION_DAYS=30
AI_RUNS_RETENTION_DAYS=90

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pulseboard
DB_USERNAME=pulseboard
DB_PASSWORD=pulseboard
# Production (Supabase Shared Pooler, Session mode, port 5432): DB_URL overrides the DB_* above
# DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# DB_SSLMODE=require
# DB_PERSISTENT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Realtime (Laravel Reverb). `log` writes the events to the log; to see the dashboard update live,
# set `reverb`, fill the REVERB_APP_* values (`php artisan reverb:install` generates them) and run
# `php artisan reverb:start`. With `reverb` and empty keys the app does not boot.
BROADCAST_CONNECTION=log
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# Where the API publishes the events (the Reverb server below).
# REVERB_HOST=localhost
# REVERB_PORT=8085
# REVERB_SCHEME=http
# Where `reverb:start` listens; 0.0.0.0 lets a phone on the same network connect.
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8085
# Where browsers and the app connect (GET /api/v1/realtime); defaults to the APP_URL host/port.
# REVERB_PUBLIC_PORT=8085
# Comma-separated Origin hosts allowed to open a WebSocket (default `*`).
# REVERB_ALLOWED_ORIGINS=*
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
