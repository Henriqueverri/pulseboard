APP_NAME=PulseBoard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# "*" when the API is only reachable through a platform proxy (Render); empty locally
TRUSTED_PROXIES=

# Public demo accounts created by `php artisan pulseboard:demo` (password: 12+ characters)
DEMO_PASSWORD=
DEMO_OWNER_EMAIL=demo@example.com
DEMO_MEMBER_EMAIL=demo-member@example.com

# PulseBoard Insights (config/ai.php). AI_ENABLED is the kill switch; organizations also opt in.
# AI_PROVIDER=scripted answers deterministically without a key or network (refused in production).
AI_ENABLED=false
AI_PROVIDER=scripted
AI_MODEL=gpt-6-luna
# Secret: set it only in your local .env or the hosting dashboard, never in Git.
OPENAI_API_KEY=
AI_DAILY_ORG_LIMIT=50
AI_DAILY_USER_LIMIT=20
AI_REQUESTS_PER_MINUTE=10
AI_DEMO_REQUESTS_PER_MINUTE_PER_IP=3

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pulseboard
DB_USERNAME=pulseboard
DB_PASSWORD=pulseboard
# Production (Supabase Shared Pooler, Session mode, port 5432): DB_URL overrides the DB_* above
# DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
