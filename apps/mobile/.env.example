# Base URL of the PulseBoard API (embedded in the bundle: never put secrets in EXPO_PUBLIC_*).
# Android emulator: http://10.0.2.2:8000/api/v1
# Physical device:  http://<your-LAN-IP>:8000/api/v1 (run the API with `php artisan serve --host=0.0.0.0 --port=8000`)
# Preview build:    https://api.henriqueverri.dev/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
